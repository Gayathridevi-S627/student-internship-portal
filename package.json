{
  "name": "mern",
  "version": "1.0.0",
  "description": "Student Internship Portal using React, Node.js, Express and MongoDB",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "nodemon index.js",
    "setup": "npm install && cd client && npm install && cd ..",
    "test": "echo \"No automated tests configured\""
  },
  "keywords": [
    "mern",
    "internship",
    "student-portal"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "mongoose": "^8.24.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
